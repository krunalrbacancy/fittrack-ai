# tries gemini-flash-lite-latest, then gemini-flash-latest, then gemma-4-26b-a4b-it,
# falling back to the next one whenever the current model's quota is exhausted (HTTP 429).
# GEMINI_MODEL=gemini-flash-lite-latest

